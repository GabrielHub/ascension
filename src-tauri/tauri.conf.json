{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ascension",
  "version": "0.1.0",
  "identifier": "com.ascension.desktop",
  "build": {
    "frontendDist": "../build/client",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "vp dev --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "vp build"
  },
  "app": {
    "macOSPrivateApi": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Ascension",
        "width": 1600,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
